{
  // Trigger a fresh Workers Build from the cloudflare-worker branch.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aevren-heartbar",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
